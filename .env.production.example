WEBUI_AUTH=True
ENABLE_SIGNUP=False
ENABLE_OPENAI_API=False
ENABLE_EVALUATION_ARENA_MODELS=False
ENABLE_VERSION_UPDATE_CHECK=False
OFFLINE_MODE=False
ANONYMIZED_TELEMETRY=False

WEBUI_URL=https://minghat.com.br
CORS_ALLOW_ORIGIN=https://minghat.com.br;https://www.minghat.com.br;https://chat.minghat.com.br
FORWARDED_ALLOW_IPS=127.0.0.1
OLLAMA_BASE_URL=http://127.0.0.1:11434
DEFAULT_LOCALE=pt-BR
WEBUI_NAME=MingHat

XCONTENT_TYPE=nosniff
XFRAME_OPTIONS=DENY
XDOWNLOAD_OPTIONS=noopen
XPERMITTED_CROSS_DOMAIN_POLICIES=none
REFERRER_POLICY=strict-origin-when-cross-origin
PERMISSIONS_POLICY=accelerometer=(),autoplay=(),camera=(),clipboard-read=(),clipboard-write=(self),fullscreen=(self),geolocation=(),gyroscope=(),magnetometer=(),microphone=(),midi=(),payment=(),picture-in-picture=(),sync-xhr=(),usb=(),xr-spatial-tracking=()
CROSS_ORIGIN_OPENER_POLICY=same-origin
HSTS=max-age=31536000;includeSubDomains;preload

MINGHAT_RECON_MAX_CONTEXT_SUBDOMAINS=1000
MINGHAT_RECON_MAX_OUTPUT_CHARS=60000
MINGHAT_RECON_MAX_STAGE_OUTPUT_CHARS=20000
MINGHAT_SUBFINDER_TIMEOUT_SECONDS=45
MINGHAT_RECON_STAGE_TIMEOUT_SECONDS=25
MINGHAT_DNSX_TIMEOUT_SECONDS=25
MINGHAT_HTTPX_TIMEOUT_SECONDS=60
MINGHAT_KATANA_TIMEOUT_SECONDS=30
MINGHAT_GAU_TIMEOUT_SECONDS=20

# Coloque chaves reais apenas em um .env local/seguro ou no painel do provedor.
# Nunca publique valores reais neste arquivo.
OPENAI_API_KEY=
WEBUI_SECRET_KEY=
